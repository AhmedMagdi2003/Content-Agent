# Loaded AFTER .env; keep provider/database keys in .env.
# Copy to .env.make only if a local setup file has not already been prepared.
PUBLISHER_BACKEND=make
PUBLIC_BASE_URL=https://YOUR-ASSIGNED-DOMAIN.ngrok-free.app
MAKE_API_TOKEN=REPLACE-WITH-A-DISTINCT-RANDOM-TOKEN-AT-LEAST-32-CHARACTERS
MAKE_CHANNELS=linkedin,website
SECURE_COOKIES=true

# Verified standard GPT-4o-mini rates per million tokens, checked 2026-10-23.
# Update these if PROVIDER or MODEL_NAME in .env changes.
INPUT_USD_PER_MILLION=0.15
OUTPUT_USD_PER_MILLION=0.60
PRICING_SOURCE_URL=https://developers.openai.com/api/docs/models/gpt-4o-mini
PRICING_CHECKED_AT=2026-10-23
