# Independent settings; no unprefixed finance environment variables are consumed.
CONTENT_MODE=cloud
# Tables are isolated in the content_ops schema, even when using the same Supabase host.
CONTENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
CONTENT_REVIEWER_TOKEN=
CONTENT_SESSION_SECRET=
CONTENT_SECURE_COOKIES=true
CONTENT_LOCAL_DATA_DIR=data
CONTENT_PROVIDER=none
CONTENT_MODEL_NAME=
CONTENT_GOOGLE_API_KEY=
CONTENT_OPENAI_API_KEY=
CONTENT_XAI_API_KEY=
CONTENT_PROVIDER_TIMEOUT=45
CONTENT_MAX_LLM_CALLS=3
CONTENT_MAX_JOB_COST_USD=0.10
CONTENT_INPUT_USD_PER_MILLION=
CONTENT_OUTPUT_USD_PER_MILLION=
CONTENT_PRICING_SOURCE_URL=
CONTENT_PRICING_CHECKED_AT=
CONTENT_MAX_INPUT_TOKENS=32000
CONTENT_PUBLISHER_URL=http://127.0.0.1:8011
CONTENT_PUBLISHER_SECRET=
CONTENT_TRACING_BACKENDS=none
