# Production / Cloud mode connected to Supabase PostgreSQL (content_ops schema)
CONTENT_MODE=cloud
CONTENT_DATABASE_URL=postgresql+psycopg://postgres.gwbviyloycizoxsktuhe:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Reviewer authentication and session security (generate distinct secrets >= 24 chars)
CONTENT_REVIEWER_TOKEN=your-secure-reviewer-token-here-minimum-24-chars
CONTENT_SESSION_SECRET=your-secure-session-secret-here-minimum-24-chars
CONTENT_SECURE_COOKIES=false
CONTENT_LOCAL_DATA_DIR=data

# AI Model Provider: "gemini", "openai", "xai", "fixture", or "none"
CONTENT_PROVIDER=none
CONTENT_MODEL_NAME=gemini-2.0-flash

# Provider API Keys
CONTENT_GOOGLE_API_KEY=
CONTENT_OPENAI_API_KEY=
CONTENT_XAI_API_KEY=

# Execution Limits
CONTENT_PROVIDER_TIMEOUT=45
CONTENT_MAX_LLM_CALLS=3
CONTENT_MAX_JOB_COST_USD=0.10
CONTENT_MAX_INPUT_TOKENS=32000

# Cost Accounting / Pricing Guard (required when calling live LLMs)
CONTENT_INPUT_USD_PER_MILLION=0.10
CONTENT_OUTPUT_USD_PER_MILLION=0.40
CONTENT_PRICING_SOURCE_URL=https://ai.google.dev/pricing
CONTENT_PRICING_CHECKED_AT=2026-10-21

# Test Publisher endpoint and shared HMAC secret
CONTENT_PUBLISHER_URL=http://127.0.0.1:8011
CONTENT_PUBLISHER_SECRET=your-secure-publisher-hmac-secret-24-chars

# Observability (Optional: "none", "langfuse", "langsmith", "both")
CONTENT_TRACING_BACKENDS=none
